{
  "description": "minigame-assets plugin hooks:\n  SessionStart — auto-update (6h throttle)\n  UserPromptSubmit — detects asset-generation intent, validates OPENAI_API_KEY",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/asset-intent.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
